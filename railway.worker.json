{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m relatorio.infrastructure.scheduler",
    "preDeployCommand": ["alembic upgrade head"],
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS"
  }
}
