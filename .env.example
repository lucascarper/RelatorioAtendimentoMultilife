# Copie para .env (que NÃO é versionado) e preencha. Na Railway, cadastre as mesmas
# variáveis em Variables de cada serviço — nunca no código.

APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO
TZ=America/Sao_Paulo

# Banco (na Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://relatorio:relatorio@localhost:5432/relatorio

# SGG (chave de 32 caracteres do SGG — secreta)
SGG_API_KEY=
SGG_BASE_URL=https://app.sgg.net.br/api/v3/
SGG_MAX_RPM=20
# false = os eventos são gravados pelo coletor do painel em tempo real (coletor único)
COLETOR_HABILITADO=true

# E-mail — KingHost via SMTP (confirmar host e STARTTLS x SSL com o provedor)
EMAIL_BACKEND=smtp             # smtp | arquivo (desenvolvimento: grava .eml em EMAIL_SAIDA_DIR)
EMAIL_SAIDA_DIR=saida_emails
SMTP_HOST=mail.kinghost.net
SMTP_PORT=587
SMTP_USER=relatorios@multilife.com.br
SMTP_PASSWORD=
EMAIL_FROM=relatorios@multilife.com.br
EMAIL_ALERTA_TECNICO=tecnologia@multilife.com.br
# Homologação: se preenchido, TODO e-mail vai só para estes endereços (separados por vírgula)
EMAIL_DESTINATARIOS_OVERRIDE=

# Admin (gere o hash com: relatorio gerar-hash-senha)
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# Assinatura do cookie de sessão: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Link do rodapé do e-mail (domínio gerado pela Railway)
ADMIN_URL=

# Regras (padrões; o admin pode sobrescrever)
TURNO_MANHA_INICIO=06:00
TURNO_TARDE_INICIO=13:00
TURNO_TARDE_FIM=18:00
ATIPICO_MIN_MINUTOS=1
ATIPICO_MAX_MINUTOS=180
